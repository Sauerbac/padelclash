# Copy to .env (`npm run setup` does this for you) and adjust as needed.
#
# REQUIRED to boot are marked [required]; the app fails loud on a missing one.
# Everything else is [optional] — its feature degrades to a dev-safe stub when
# the value is blank, so a fresh clone runs with no secrets to obtain (Q1: the
# app runs against a real DB; external services are stubbed locally).

# ── Database [required] ───────────────────────────────────────────────────────
# Matches the docker-compose `db` service. Change the port here if 5432 is taken
# on your machine (and in docker-compose.yml to match).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/padelclash

# ── Auth — Better Auth (slice 06) ─────────────────────────────────────────────
# [required from slice 06] Session-signing secret. The dev value below is fine
# for local use; generate a real one for any deployed environment
# (`openssl rand -base64 32`). Never reuse this value outside local dev.
BETTER_AUTH_SECRET=dev-only-insecure-secret-change-me
# [required from slice 06] Base URL the auth callbacks resolve against.
BETTER_AUTH_URL=http://localhost:3000

# ── Transactional email — Resend (slice 06) ──────────────────────────────────
# [optional] Leave blank in dev: the EmailSender port falls back to the console
# adapter, which prints verification/claim links to the server log instead of
# sending mail. Set a real key only when testing the live email path.
RESEND_API_KEY=
EMAIL_FROM=PadelClash <onboarding@localhost>

# ── Google sign-in (slice 06+) ────────────────────────────────────────────────
# [optional] Leave blank in dev: Google sign-in is simply not offered when these
# are absent. Email+password is the primary local path.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
