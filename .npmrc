# better-auth (1.6) declares @tanstack/react-start as an *optional* peer, which in
# turn wants vite>=7 — colliding with vitest 2's vite@5. We use neither
# @tanstack/react-start nor that vite, so the conflict is spurious. legacy-peer-deps
# lets `npm install`/`npm ci` (local, CI, and the Docker build) resolve past it.
legacy-peer-deps=true
